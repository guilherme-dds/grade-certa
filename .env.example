DATABASE_URL=mysql+pymysql://grade_user:grade_password@localhost:3306/grade_certa
SECRET_KEY=sua_chave_secreta_super_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de dados (docker compose). No ambiente local podem ficar vazias: valem as senhas
# padrão do docker-compose.yml. Em produção são obrigatórias; use só letras e números
# (ex.: openssl rand -hex 24), porque a senha entra no endereço de conexão
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Produção (docker-compose.prod.yml): domínio que aponta para o servidor, usado no HTTPS
DOMINIO=
# Memória máxima do worker de geração (padrão 2g)
# WORKER_MEM_LIMIT=2g
